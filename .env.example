# Copy to .env for running the API outside Docker (`make run`).
DATABASE_URL=postgres://quickbytes:quickbytes@localhost:5432/quickbytes?sslmode=disable
HTTP_ADDR=:8080
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Optional. Without it the API runs with no cache.
REDIS_URL=redis://localhost:6379/0
# Password of every demo account, for running the seeder by hand with this file
# (`go run ./cmd/seed`). `make seed` passes the same default itself. Demo only: the
# seeder refuses any database that isn't local.
SEED_PASSWORD=quickbytes-demo
# The payment provider (`make up` starts it on :8090), the API's merchant key
# there and the secret that checks its webhooks: the development values from
# docker-compose.yml. Required.
PAYPROVIDER_URL=http://localhost:8090
PAYPROVIDER_KEY=sk_test_dev_only_quickbytes_0123456789abcdef
PAYPROVIDER_WEBHOOK_SECRET=whsec_dev_only_quickbytes_0123456789abcdef
